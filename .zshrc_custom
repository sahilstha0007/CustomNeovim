# ============================================================================
# Zsh Custom Configuration (~/.zshrc_custom)
# Loaded AFTER ~/.config/zshrc/* via ML4W's .zshrc loader
# ============================================================================

# ---------------------------------------------------------------------------
# Package managers & language runtimes
# ---------------------------------------------------------------------------

# Go — binaries in $GOPATH/bin (gopls, dlv, goimports, …)
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# npm global packages
export PATH="$HOME/.npm-global/bin:$HOME/bin:$PATH"

# bun — installed via pacman at /usr/bin/bun (v1.3.14)
# System package, so no extra PATH needed.
# For a local install instead (curl -fsSL https://bun.sh/install), use:
#   export BUN_INSTALL="$HOME/.bun"
#   export PATH="$BUN_INSTALL/bin:$PATH"

# ---------------------------------------------------------------------------
# Editors & tools
# ---------------------------------------------------------------------------

export EDITOR="nvim"
export BROWSER="brave"

# ---------------------------------------------------------------------------
# Modern tools: zoxide + tuned fzf + bigger history
# ---------------------------------------------------------------------------

# zoxide: smarter cd -> use `z <partial-name>`
eval "$(zoxide init zsh)"

# mise: per-project tool versions (node/php/bun...) — activate after PATH setup
eval "$(mise activate zsh)"

# atuin: synced, searchable shell history — takes over ctrl+r from fzf
eval "$(atuin init zsh)"

# fzf: fd-backed sources + nice UI + bat preview (ctrl-/ toggles preview)
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
  --preview 'bat --color=always --style=numbers --line-range=:300 {1}' \
  --bind 'ctrl-/:toggle-preview'"

# bigger history than the ml4w default
HISTSIZE=100000
SAVEHIST=100000
setopt hist_ignore_all_dups hist_reduce_blanks sharehistory

# ---------------------------------------------------------------------------
# dotfiles — versioned backup of ~/.config (bare repo in ~/.dotfiles)
#   dotfiles status / dotfiles add -A / dotfiles commit -m "..."
# ---------------------------------------------------------------------------
alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
# mydotfiles — the full terminal stack (nvim/wezterm/tmux/shell), bare repo in
# ~/.gitmydotfiles → github.com/sahilstha0007/mydotfiles
#   mydotfiles status / mydotfiles add -A / mydotfiles commit -m "..."
alias mydotfiles='/usr/bin/git --git-dir=$HOME/.gitmydotfiles --work-tree=$HOME'

# ---------------------------------------------------------------------------
# Shell highlighting — wallpaper palette (PURE APPEARANCE; delete this block
# to revert). Two fixes:
#   1. text looked dim/faint WHILE typing until the command resolved — caused
#      by fast-syntax-highlighting + zsh-syntax-highlighting running together
#      (removed F-Sy-H via ~/.config/zshrc/custom/20-customization).
#   2. zsh-autosuggestions used fg=8 (ANSI "bright black") which this palette
#      maps to a near-black surface, so suggestions were nearly invisible.
# Colors follow the live wallpaper palette (~/.config/wezterm/colors/matugen.lua)
# so this stays in family with tmux/wezterm/nvim.
# ---------------------------------------------------------------------------

# Suggestions: warm gray — clearly readable, still visually "behind" the text
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#9b8f80"

# zsh-syntax-highlighting — every state carries a visible filled color, so no
# token is ever left dim while you type. (Styles are read live by the plugin,
# so setting them here, after oh-my-zsh loaded, is fine.)
ZSH_HIGHLIGHT_STYLES[default]="none"
ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#ffb4ab,bold"
ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#f3bd6e,bold"
ZSH_HIGHLIGHT_STYLES[alias]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[builtin]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[function]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[command]="fg=#b7cea2,bold"
ZSH_HIGHLIGHT_STYLES[precommand]="fg=#ffb4ab,bold"
ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#f3bd6e"
ZSH_HIGHLIGHT_STYLES[path]="fg=#f3bd6e"
ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#f3bd6e"
ZSH_HIGHLIGHT_STYLES[path_approx]="fg=#ffb4ab"
ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#ede0d4"
ZSH_HIGHLIGHT_STYLES[redirection]="fg=#ede0d4"
ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#ffb4ab"
ZSH_HIGHLIGHT_STYLES[comment]="fg=#9b8f80,italic"
ZSH_HIGHLIGHT_STYLES[assign]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[arg0]="fg=#b7cea2"
# Fill EVERY state — zsh's stock theme styles paths/globbing as underline-only
# ("color on the border, not inside"); these paint the glyphs themselves.
ZSH_HIGHLIGHT_STYLES[globbing]="fg=#f3bd6e,bold"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#ede0d4"
ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#b7cea2"
ZSH_HIGHLIGHT_STYLES[bracket-error]="fg=#ffb4ab,bold"
ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]="fg=#ede0d4,bold"

# Nonexistent commands: complementary hue of the current wallpaper accent,
# computed at wallpaper-sync time (overrides unknown-token above when a sync
# has run). zsh-syntax-highlighting reads styles live, so new shells are
# always current.
[ -f "$HOME/.cache/zsh-wallpaper.zsh" ] && source "$HOME/.cache/zsh-wallpaper.zsh"
